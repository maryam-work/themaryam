{
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/collections/:path*",
            "destination": "https://shop.themaryam.in/collections/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/anniversary-gifts",
            "destination": "/anniversary-gifts.html"
        },
        {
            "source": "/bestsellers",
            "destination": "/bestsellers.html"
        },
        {
            "source": "/cakes",
            "destination": "/cakes.html"
        },
        {
            "source": "/flowers",
            "destination": "/flowers.html"
        },
        {
            "source": "/same-day-delivery",
            "destination": "/same-day-delivery.html"
        },
        {
            "source": "/wedding-gifts",
            "destination": "/wedding-gifts.html"
        },
        {
            "source": "/contact",
            "destination": "/contact.html"
        },
        {
            "source": "/pages/faq",
            "destination": "/pages/faq.html"
        },
        {
            "source": "/pages/track-order",
            "destination": "/pages/track-order.html"
        },
        {
            "source": "/policies/:path*",
            "destination": "/policies/:path.html"
        },
        {
            "source": "/((?!api|_next/static|_next/image|favicon.ico|.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.gif|.*\\.svg|.*\\.ico|.*\\.xml|.*\\.txt|.*\\.webmanifest|.*\\.html).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain"
                }
            ]
        }
    ]
}
